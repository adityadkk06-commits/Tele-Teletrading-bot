# ─── Required ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here   # set via /setchat command

# ─── Optional API Keys (improves data quality) ───────────────────────────────
BIRDEYE_API_KEY=       # birdeye.so — holder data, smart money
GMGN_API_KEY=          # gmgn.ai — fresh wallet ratio, smart money
GOPLUS_API_KEY=        # gopluslabs.io — contract security checks
HELIUS_API_KEY=        # helius.xyz — Solana RPC (optional)
BUBBLEMAPS_API_KEY=    # bubblemaps.io — wallet cluster analysis

# ─── Notes ───────────────────────────────────────────────────────────────────
# RugCheck (rugcheck.xyz) and Honeypot.is are used without API keys (free tier)
# Pump.fun API is public (no key needed)
# DEX Screener API is public (no key needed)
